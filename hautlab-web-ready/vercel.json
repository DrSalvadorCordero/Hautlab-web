{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "feature/*": false,
      "fix/*": false,
      "chore/*": false,
      "docs/*": false,
      "dependabot/*": false
    }
  },
  "ignoreCommand": "node -e \"const u=process.env.VERCEL_PROJECT_PRODUCTION_URL||''; process.exit(/(^|\\.)hautlabmx\\.com$|^hautlabmxcom\\.vercel\\.app$/.test(u)?1:0)\""
}
